extends ../layout

mixin camposUsuario(prefijo, esEdicion)
  +campo(prefijo + "usuario", "Usuario")(type="text" name="usuario" required)
  +campo(prefijo + "nombre", "Nombre")(type="text" name="nombre" required)
  +campo(prefijo + "password", esEdicion ? "Nueva contraseña (vacío = no cambia)" : "Contraseña")(type="text" name="password" minlength="6" required=!esEdicion)
  +campoSelect(prefijo + "rol", "Rol")(class="select-rol" name="rol" required)
    each rol in roles
      option(value=rol selected=rol === "profesional")= rol
  +campoSelect(prefijo + "profesional", "Profesional vinculado")(class="select-profesional" name="profesional")
    option(value="") Ninguno
  +campo(prefijo + "expiraEl", "Vence el (opcional)")(type="datetime-local" name="expiraEl")
  if esEdicion
    label(class="flex items-center gap-2 self-end py-2 text-sm font-medium text-gray-800")
      input(type="checkbox" name="activo" class="size-4 rounded border-gray-300 accent-marca")
      | Activo

block content
  +encabezado("Gestión de Usuarios", "Cuentas de acceso, roles y vencimientos.")

  if puede("usuarios:create")
    +seccion("Crear usuario", 'Por mínimo privilegio, el rol por defecto es "profesional".')
      +alerta("errorAlta")
      form#formAlta(class="grid grid-cols-1 gap-x-6 gap-y-4 lg:grid-cols-2")
        +camposUsuario("alta_", false)
        +botonera
          button.btn.btn-primario(type="submit")
            +icono("mas")(class="size-4")
            | Crear Usuario

  +seccion("Listado de usuarios")
    +alerta("errorListado")
    +tabla(["Usuario", "Nombre", "Rol", "Profesional", "Estado", "Vence", "Creado", "Modificado", "Último acceso", "Acciones"], "tablaUsuarios")

  +modal("modalEditar", "Editar Usuario")
    +alerta("errorEdicion")
    form#formEditar(class="grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2")
      input(type="hidden" name="_id")
      +camposUsuario("edit_", true)
      +botonera
        button.btn.btn-secundario.btn-cerrar-modal(type="button") Cancelar
        button.btn.btn-primario(type="submit")
          +icono("guardar")(class="size-4")
          | Guardar Cambios

block scripts
  script(src="/js/usuarios.js")
