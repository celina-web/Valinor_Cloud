extends layout

block content
  +encabezado("Hola, " + usuario.nombre)
    p(class="flex flex-wrap items-center gap-2 text-sm text-gray-600")
      span Rol:
      span.etiqueta.etiqueta-info= usuario.rol
      if usuario.rol === "profesional"
        span Ves únicamente tus propios turnos.

  section(aria-labelledby="tituloResumen")
    h2#tituloResumen(class="mb-3 text-lg font-semibold text-gray-900") Turnos de hoy
    div(class="grid grid-cols-1 gap-4 sm:grid-cols-3")
      +tarjetaResumen("cantidadReservados", "Reservados", "reloj", "confirmado")
      +tarjetaResumen("cantidadAtendidos", "Atendidos", "atendido", "finalizado")
      +tarjetaResumen("cantidadCancelados", "Cancelados", "cancelado", "cancelado")

  +seccion("Agenda del día")
    +alerta("errorTurnos")
    +tabla(["Fecha", "Hora", "Cliente", "Profesional", "Estado", "Acciones"], "tablaTurnos")
    +vacio("sinTurnos", "No hay turnos para hoy.")

block scripts
  script(src="/js/turnosTabla.js")
  script(src="/js/panel.js")
