extends layout

block content
  h1 Hola, #{usuario.nombre}
  p
    | Rol: 
    strong= usuario.rol
    if usuario.rol === "profesional"
      |  - Ves únicamente tus propios turnos.

  h2 Turnos de hoy
  .resumen
    .tarjeta
      span.numero#cantidadReservados 0
      span Reservados
    .tarjeta
      span.numero#cantidadAtendidos 0
      span Atendidos
    .tarjeta
      span.numero#cantidadCancelados 0
      span Cancelados

  .error#errorTurnos(hidden)
  table
    thead
      tr
        th Fecha
        th Hora
        th Cliente
        th Profesional
        th Estado
        th Acciones
    tbody#tablaTurnos
  p#sinTurnos(hidden) No hay turnos para hoy.

block scripts
  script(src="/js/turnosTabla.js")
  script(src="/js/panel.js")
