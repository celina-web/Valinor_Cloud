//- Componentes reutilizables de las vistas. Todo el estilo es con clases de Tailwind.

//- Íconos SVG inline (trazos estilo Lucide, 24x24).
-
  const iconos = {
    calendario: ["M8 2v4", "M16 2v4", "M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z", "M3 10h18", "m9 16 2 2 4-4"],
    inicio: ["M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8", "M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"],
    clientes: ["M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", "M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0", "M22 21v-2a4 4 0 0 0-3-3.87", "M16 3.13a4 4 0 0 1 0 7.75"],
    profesionales: ["M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16", "M4 6h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"],
    usuarios: ["M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z", "m9 12 2 2 4-4"],
    auditoria: ["M9 2h6a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z", "M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2", "M12 11h4", "M12 16h4", "M8 11h.01", "M8 16h.01"],
    menu: ["M4 6h16", "M4 12h16", "M4 18h16"],
    cerrar: ["M18 6 6 18", "m6 6 12 12"],
    salir: ["m16 17 5-5-5-5", "M21 12H9", "M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"],
    reloj: ["M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0", "M12 6v6l4 2"],
    atendido: ["M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0", "m9 12 2 2 4-4"],
    cancelado: ["M2 12a10 10 0 1 0 20 0a10 10 0 1 0-20 0", "m15 9-6 6", "m9 9 6 6"],
    mas: ["M5 12h14", "M12 5v14"],
    guardar: ["M20 6 9 17l-5-5"],
    filtro: ["M22 3H2l8 9.46V19l4 2v-8.54L22 3z"],
  };

  const claseControl = "block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-900 shadow-xs placeholder:text-gray-400 focus:border-marca focus:outline-none focus:ring-2 focus:ring-marca/30 disabled:cursor-not-allowed disabled:bg-gray-100 disabled:text-gray-500";

  const claseEtiquetaCampo = "text-sm font-medium text-gray-800";

mixin icono(nombre)
  svg(xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false")&attributes(attributes)
    each trazo in iconos[nombre] || []
      path(d=trazo)

//- Logo de TurnoFlex: calendario con check sobre una baldosa del color de marca.
mixin logo(tamanio)
  - const grande = tamanio === "grande"
  span(class=["inline-flex shrink-0 items-center justify-center bg-marca text-white shadow-sm", grande ? "size-16 rounded-2xl" : "size-9 rounded-xl"])
    +icono("calendario")(class=grande ? "size-9" : "size-5")

//- Título de página con descripción opcional.
mixin encabezado(titulo, descripcion)
  header(class="flex flex-col gap-1")
    h1(class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl")= titulo
    if descripcion
      p(class="text-sm text-gray-600")= descripcion
    if block
      block

//- Tarjeta blanca que agrupa un bloque de la página.
mixin seccion(titulo, descripcion)
  section(class="rounded-2xl border border-gray-200 bg-white p-4 shadow-sm sm:p-6")&attributes(attributes)
    if titulo
      header(class="mb-5")
        h2(class="text-lg font-semibold text-gray-900")= titulo
        if descripcion
          p(class="mt-1 text-sm text-gray-600")= descripcion
    block

//- Campo de texto/fecha/etc. Los atributos extra van al <input>.
//- opciones: { contenedor: clases del div, sinMarca: no mostrar el asterisco de obligatorio }
mixin campo(id, etiqueta, opciones)
  - opciones = opciones || {}
  div(class=["flex min-w-0 flex-col gap-1.5", opciones.contenedor])
    label(for=id class=claseEtiquetaCampo)
      | #{etiqueta}
      if attributes.required && !opciones.sinMarca
        span(class="ml-0.5 text-turno-cancelado" aria-hidden="true") *
    input(id=id class=claseControl)&attributes(attributes)

//- Select con sus <option> pasadas como bloque.
mixin campoSelect(id, etiqueta, opciones)
  - opciones = opciones || {}
  div(class=["flex min-w-0 flex-col gap-1.5", opciones.contenedor])
    label(for=id class=claseEtiquetaCampo)
      | #{etiqueta}
      if attributes.required && !opciones.sinMarca
        span(class="ml-0.5 text-turno-cancelado" aria-hidden="true") *
    select(id=id class=claseControl)&attributes(attributes)
      block

//- Fila de botones al pie de un formulario en grilla (ocupa todas las columnas).
mixin botonera
  div(class="col-span-full flex flex-wrap justify-end gap-3 pt-2")
    block

//- Mensaje de error; el JS lo muestra/oculta con mostrarError().
mixin alerta(id)
  div(id=id hidden role="alert" class="mb-4 rounded-lg border border-turno-cancelado/30 bg-turno-cancelado/10 px-4 py-3 text-sm font-medium text-red-900")

//- Tabla con scroll horizontal propio; el <tbody> lo llena el JS.
mixin tabla(columnas, idTbody)
  div(class="overflow-x-auto rounded-xl border border-gray-200")
    table(class="min-w-full text-left text-sm text-gray-800 [&_td]:px-4 [&_td]:py-3 [&_td]:align-middle")
      thead(class="border-b border-gray-200 bg-gray-50 text-xs font-semibold tracking-wide text-gray-600 uppercase")
        tr
          each columna in columnas
            th(scope="col" class="px-4 py-3 whitespace-nowrap")= columna
      //- divide-y: borde fino negro entre filas (debajo de cada una, salvo la última).
      tbody(id=idTbody class="divide-y divide-gray-400 bg-white")

//- Texto para listados vacíos.
mixin vacio(id, texto)
  p(id=id hidden class="py-8 text-center text-sm text-gray-500")= texto

//- Modal de edición; se abre/cierra con el atributo hidden desde el JS.
mixin modal(id, titulo)
  div(id=id hidden role="dialog" aria-modal="true" aria-labelledby=id + "Titulo" class="fixed inset-0 z-50 flex items-center justify-center bg-gray-900/40 p-4")
    div(class="max-h-[calc(100dvh-2rem)] w-full max-w-2xl overflow-y-auto rounded-2xl bg-white p-6 shadow-xl")
      h3(id=id + "Titulo" class="mb-4 text-lg font-semibold text-gray-900")= titulo
      block

//- Tarjeta de resumen del panel (cantidad de turnos por estado).
mixin tarjetaResumen(id, texto, icono, variante)
  -
    const estilos = {
      confirmado: { franja: "border-l-turno-confirmado", icono: "bg-turno-confirmado/10 text-turno-confirmado" },
      finalizado: { franja: "border-l-gray-400", icono: "bg-turno-finalizado text-gray-700" },
      cancelado: { franja: "border-l-turno-cancelado", icono: "bg-turno-cancelado/10 text-turno-cancelado" },
    }[variante];
  div(class=["flex items-center gap-4 rounded-2xl border border-l-4 border-gray-200 bg-white p-4 shadow-sm", estilos.franja])
    span(class=["inline-flex size-11 shrink-0 items-center justify-center rounded-xl", estilos.icono])
      +icono(icono)(class="size-6")
    div
      span(id=id class="block text-3xl leading-none font-bold text-gray-900") 0
      span(class="mt-1 block text-sm font-medium text-gray-600")= texto

//- Enlace de la sidebar; en desktop colapsada solo se ve el ícono (con tooltip por title).
mixin enlaceSidebar(href, texto, icono, activo)
  a(href=href title=texto aria-current=activo ? "page" : false class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium text-indigo-profundo/80 transition-colors hover:bg-lavanda-200 hover:text-indigo-profundo focus-visible:outline-2 focus-visible:outline-marca aria-[current=page]:bg-white aria-[current=page]:font-semibold aria-[current=page]:text-indigo-profundo aria-[current=page]:shadow-sm lg:colapsada:justify-center lg:colapsada:px-0")
    +icono(icono)(class="size-5 shrink-0")
    span(class="truncate lg:colapsada:sr-only")= texto
