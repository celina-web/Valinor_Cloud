-
  const ruta = rutaActual || "";
  const esActivo = (href) => (href === "/" ? ruta === "/" : ruta === href || ruta.startsWith(href + "/"));
  const modulos = [
    { href: "/turnos", texto: "Turnos", icono: "calendario", permiso: "turnos:read" },
    { href: "/clientes", texto: "Clientes", icono: "clientes", permiso: "clientes:read" },
    { href: "/profesionales", texto: "Profesionales", icono: "profesionales", permiso: "profesionales:read" },
  ].filter((modulo) => puede(modulo.permiso));
  const administracion = [
    { href: "/usuarios", texto: "Usuarios", icono: "usuarios", permiso: "usuarios:read" },
    { href: "/auditoria", texto: "Auditoría", icono: "auditoria", permiso: "auditoria:read" },
  ].filter((modulo) => puede(modulo.permiso));

//- Overlay del drawer (solo móvil/tablet).
div#overlaySidebar(class="fixed inset-0 z-40 hidden bg-gray-900/30 max-lg:drawer-abierto:block" aria-hidden="true")

aside#sidebar(
  aria-label="Menú principal"
  class="fixed inset-y-0 left-0 z-50 flex w-64 -translate-x-full flex-col border-r border-lavanda-200 bg-lavanda-100 text-indigo-profundo transition-[translate,visibility,width] duration-200 max-lg:invisible max-lg:drawer-abierto:visible max-lg:drawer-abierto:translate-x-0 max-lg:drawer-abierto:shadow-xl lg:static lg:z-auto lg:shrink-0 lg:translate-x-0 lg:colapsada:w-18"
)
  //- Cabecera del drawer en móvil/tablet (en desktop ya está la navbar).
  div(class="flex h-16 shrink-0 items-center justify-between border-b border-lavanda-200 px-4 lg:hidden")
    a(href="/" class="flex items-center gap-2.5")
      +logo()
      span(class="text-lg font-bold tracking-tight") TurnoFlex
    button#btnCerrarSidebar(type="button" aria-label="Cerrar el menú" class="inline-flex size-10 cursor-pointer items-center justify-center rounded-lg hover:bg-lavanda-200 focus-visible:outline-2 focus-visible:outline-marca")
      +icono("cerrar")(class="size-5")

  //- En desktop la columna ocupa todo el alto y solo el menú queda fijo al hacer scroll.
  nav(class="flex flex-1 flex-col gap-1 overflow-y-auto p-3 lg:sticky lg:top-16 lg:max-h-[calc(100dvh-4rem)] lg:flex-none")
    +enlaceSidebar("/", "Inicio", "inicio", esActivo("/"))
    each modulo in modulos
      +enlaceSidebar(modulo.href, modulo.texto, modulo.icono, esActivo(modulo.href))
    if administracion.length
      p(class="mt-4 mb-1 px-3 text-xs font-semibold tracking-wider text-indigo-profundo/60 uppercase lg:colapsada:sr-only") Administración
      div(class="mx-3 my-2 hidden border-t border-lavanda-300 lg:colapsada:block" aria-hidden="true")
      each modulo in administracion
        +enlaceSidebar(modulo.href, modulo.texto, modulo.icono, esActivo(modulo.href))
