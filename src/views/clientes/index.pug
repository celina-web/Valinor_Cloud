extends ../layout

block content
  +encabezado("Gestión de Clientes", "Alta, edición y baja de los clientes del centro.")

  if puede("clientes:create")
    +seccion("Registrar nuevo cliente")
      +alerta("errorAlta")
      form#formAlta(class="grid grid-cols-1 gap-x-6 gap-y-4 lg:grid-cols-2")
        +campo("nombre", "Nombre")(type="text" name="nombre" required)
        +campo("apellido", "Apellido")(type="text" name="apellido" required)
        +campo("dni", "DNI")(type="text" name="dni" inputmode="numeric" placeholder="7 u 8 dígitos" required)
        +campo("telefono", "Teléfono")(type="text" name="telefono" inputmode="tel")
        +campo("email", "Email", { contenedor: "lg:col-span-2" })(type="email" name="email")
        +botonera
          button.btn.btn-primario(type="submit")
            +icono("mas")(class="size-4")
            | Guardar Cliente

  +seccion("Listado de clientes")
    +alerta("errorListado")
    +tabla(["Nombre", "Apellido", "DNI", "Teléfono", "Email", "Acciones"], "tablaClientes")
    +vacio("sinRegistros", "No hay clientes registrados actualmente.")

  +modal("modalEditar", "Editar Cliente")
    +alerta("errorEdicion")
    form#formEditar(class="grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2")
      input(type="hidden" name="_id")
      +campo("edit_nombre", "Nombre")(type="text" name="nombre" required)
      +campo("edit_apellido", "Apellido")(type="text" name="apellido" required)
      +campo("edit_dni", "DNI")(type="text" name="dni" inputmode="numeric" required)
      +campo("edit_telefono", "Teléfono")(type="text" name="telefono" inputmode="tel")
      +campo("edit_email", "Email", { contenedor: "md:col-span-2" })(type="email" name="email")
      +botonera
        button.btn.btn-secundario.btn-cerrar-modal(type="button") Cancelar
        button.btn.btn-primario(type="submit")
          +icono("guardar")(class="size-4")
          | Guardar Cambios

block scripts
  script(src="/js/clientes.js")
