extends ../layout

block content
  h1 Gestión de Clientes

  if error
    .error= error

  if exito
    .success= exito

  h2 Registrar Nuevo Cliente
  form(action="/clientes" method="POST")
    .form-group
      label(for="nombre") Nombre *
      input#nombre(type="text" name="nombre" value=formData ? formData.nombre : '' required)
    
    .form-group
      label(for="apellido") Apellido *
      input#apellido(type="text" name="apellido" value=formData ? formData.apellido : '' required)
    
    .form-group
      label(for="dni") DNI *
      input#dni(type="text" name="dni" value=formData ? formData.dni : '' required)
    
    .form-group
      label(for="telefono") Teléfono
      input#telefono(type="text" name="telefono" value=formData ? formData.telefono : '')
    
    button(type="submit") Guardar Cliente

  hr

  h2 Listado de Clientes
  if clientes.length > 0
    table
      thead
        tr
          th ID
          th Nombre
          th Apellido
          th DNI
          th Teléfono
          th Acciones
      tbody
        each cliente in clientes
          tr
            td= cliente.id
            td= cliente.nombre
            td= cliente.apellido
            td= cliente.dni
            td= cliente.telefono || '-'
            td
              button(type="button" style="background:#ffc107; color:black; margin-right:5px; padding: 5px 10px; border:none; border-radius:3px; cursor:pointer;" onclick=`abrirModalEditar(${JSON.stringify(cliente)})`) Editar
              form(action=`/clientes/${cliente.id}/eliminar` method="POST" style="display:inline;")
                button.btn-danger(type="submit" onclick="return confirm('¿Seguro que deseas eliminar este cliente?')") Eliminar
  else
    p No hay clientes registrados actualmente.

  // Modal de Edición
  #modalEditar(style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000;")
    div(style="background:white; width:400px; margin:100px auto; padding:200px; padding:20px; border-radius:5px; position:relative;")
      h3 Editar Cliente
      form#formEditar(method="POST")
        .form-group
          label(for="edit_nombre") Nombre *
          input#edit_nombre(type="text" name="nombre" required)
        
        .form-group
          label(for="edit_apellido") Apellido *
          input#edit_apellido(type="text" name="apellido" required)
        
        .form-group
          label(for="edit_dni") DNI *
          input#edit_dni(type="text" name="dni" required)
        
        .form-group
          label(for="edit_telefono") Teléfono
          input#edit_telefono(type="text" name="telefono")
        
        div(style="display:flex; justify-content:space-between; margin-top:15px;")
          button(type="submit") Guardar Cambios
          button(type="button" style="background:#6c757d;" onclick="cerrarModalEditar()") Cancelar

  script.
    function abrirModalEditar(cliente) {
      document.getElementById('formEditar').action = `/clientes/${cliente.id}/editar`;
      document.getElementById('edit_nombre').value = cliente.nombre;
      document.getElementById('edit_apellido').value = cliente.apellido;
      document.getElementById('edit_dni').value = cliente.dni;
      document.getElementById('edit_telefono').value = cliente.telefono || '';
      document.getElementById('modalEditar').style.display = 'block';
    }

    function cerrarModalEditar() {
      document.getElementById('modalEditar').style.display = 'none';
    }
