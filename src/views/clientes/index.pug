extends ../layout

block content
  h1 Gestión de Clientes

  if puede("clientes:create")
    h2 Registrar Nuevo Cliente
    .error#errorAlta(hidden)
    form#formAlta
      .form-group
        label(for="nombre") Nombre *
        input#nombre(type="text" name="nombre" required)
      .form-group
        label(for="apellido") Apellido *
        input#apellido(type="text" name="apellido" required)
      .form-group
        label(for="dni") DNI *
        input#dni(type="text" name="dni" inputmode="numeric" required)
      .form-group
        label(for="telefono") Teléfono
        input#telefono(type="text" name="telefono")
      .form-group
        label(for="email") Email
        input#email(type="email" name="email")
      button(type="submit") Guardar Cliente
    hr

  h2 Listado de Clientes
  .error#errorListado(hidden)
  table
    thead
      tr
        th Nombre
        th Apellido
        th DNI
        th Teléfono
        th Email
        th Acciones
    tbody#tablaClientes
  p#sinRegistros(hidden) No hay clientes registrados actualmente.

  .modal#modalEditar(hidden)
    .modal-contenido
      h3 Editar Cliente
      .error#errorEdicion(hidden)
      form#formEditar
        input(type="hidden" name="_id")
        .form-group
          label(for="edit_nombre") Nombre *
          input#edit_nombre(type="text" name="nombre" required)
        .form-group
          label(for="edit_apellido") Apellido *
          input#edit_apellido(type="text" name="apellido" required)
        .form-group
          label(for="edit_dni") DNI *
          input#edit_dni(type="text" name="dni" inputmode="numeric" required)
        .form-group
          label(for="edit_telefono") Teléfono
          input#edit_telefono(type="text" name="telefono")
        .form-group
          label(for="edit_email") Email
          input#edit_email(type="email" name="email")
        .modal-botones
          button(type="submit") Guardar Cambios
          button.btn-secundario.btn-cerrar-modal(type="button") Cancelar

block scripts
  script(src="/js/clientes.js")
