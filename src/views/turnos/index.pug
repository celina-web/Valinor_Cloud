extends ../layout

block content
  h1 Gestión de Turnos

  if puede("turnos:create")
    h2 Reservar Nuevo Turno
    .error#errorAlta(hidden)
    form#formAlta
      .form-group
        label(for="cliente") Cliente *
        select#cliente(name="cliente" required)
          option(value="") Seleccioná un cliente
      .form-group
        label(for="profesional") Profesional *
        select#profesional(name="profesional" required)
          option(value="") Seleccioná un profesional
      .form-group
        label(for="fecha") Fecha *
        input#fecha(type="date" name="fecha" required)
      .form-group
        label(for="hora") Hora *
        input#hora(type="time" name="hora" required)
      button(type="submit") Reservar Turno
    hr

  h2 Listado de Turnos
  form#formFiltros.filtros
    .form-group
      label(for="filtroEstado") Estado
      select#filtroEstado(name="estado")
        option(value="") Todos
        option(value="reservado") Reservado
        option(value="atendido") Atendido
        option(value="cancelado") Cancelado
    .form-group
      label(for="filtroFecha") Fecha
      input#filtroFecha(type="date" name="fecha")
    button.btn-secundario#btnLimpiarFiltros(type="button") Limpiar

  .error#errorTurnos(hidden)
  table
    thead
      tr
        th Fecha
        th Hora
        th Cliente
        th Profesional
        th Estado
        th Acciones
    tbody#tablaTurnos
  p#sinTurnos(hidden) No hay turnos que coincidan.

block scripts
  script(src="/js/turnosTabla.js")
  script(src="/js/turnos.js")
