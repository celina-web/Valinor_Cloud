extends ../layout

block content
  +encabezado("Gestión de Turnos", "Reservá turnos y seguí su estado durante el día.")

  if puede("turnos:create")
    +seccion("Reservar nuevo turno")
      +alerta("errorAlta")
      form#formAlta(class="grid grid-cols-1 gap-x-6 gap-y-4 lg:grid-cols-2")
        +campoSelect("cliente", "Cliente")(name="cliente" required)
          option(value="") Seleccioná un cliente
        +campoSelect("profesional", "Profesional")(name="profesional" required)
          option(value="") Seleccioná un profesional
        +campo("fecha", "Fecha")(type="date" name="fecha" required)
        +campo("hora", "Hora")(type="time" name="hora" required)
        +botonera
          button.btn.btn-primario(type="submit")
            +icono("calendario")(class="size-4")
            | Reservar Turno

  +seccion("Listado de turnos")
    form#formFiltros(class="mb-4 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:items-end")
      +campoSelect("filtroEstado", "Estado", { contenedor: "sm:w-48" })(name="estado")
        option(value="") Todos
        option(value="reservado") Reservado
        option(value="atendido") Atendido
        option(value="cancelado") Cancelado
      +campo("filtroFecha", "Fecha", { contenedor: "sm:w-48" })(type="date" name="fecha")
      button.btn.btn-secundario#btnLimpiarFiltros(type="button") Limpiar

    +alerta("errorTurnos")
    +tabla(["Fecha", "Hora", "Cliente", "Profesional", "Estado", "Acciones"], "tablaTurnos")
    +vacio("sinTurnos", "No hay turnos que coincidan.")

block scripts
  script(src="/js/turnosTabla.js")
  script(src="/js/turnos.js")
