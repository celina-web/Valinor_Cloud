extends layouts/base

//- Variables: codigo (status HTTP), titulo y mensaje. Las setean notFound/errorHandler
//- (src/middlewares/errores.js) y requierePermiso (src/middlewares/auth.js).
block titulo
  | #{titulo || "Error"} · TurnoFlex

block cuerpo
  -
    const icono = codigo === 404 ? "noEncontrado" : codigo === 403 ? "candado" : "alerta";
    const estiloIcono = codigo >= 500 || !codigo
      ? "bg-turno-cancelado/10 text-turno-cancelado"
      : "bg-lavanda-100 text-marca";
  main(class="flex flex-1 flex-col items-center justify-center px-4 py-12 sm:py-16")
    div(class="mb-8 flex items-center gap-3")
      +logo
      span(class="text-xl font-bold tracking-tight text-indigo-profundo") TurnoFlex
    section(class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 text-center shadow-sm sm:p-8" aria-labelledby="tituloError")
      span(class=["mx-auto inline-flex size-14 items-center justify-center rounded-full", estiloIcono])
        +icono(icono)(class="size-7")
      if codigo
        p(class="mt-4 text-sm font-semibold tracking-widest text-marca uppercase") Error #{codigo}
      h1#tituloError(class="mt-2 text-2xl font-bold tracking-tight text-gray-900")= titulo || "Ocurrió un error"
      p(class="mt-3 text-sm text-gray-600")= mensaje || "No pudimos completar tu solicitud. Intentá nuevamente en unos minutos."
      a.btn.btn-primario(href="/" class="mt-6 px-5 py-2.5")
        +icono("inicio")(class="size-4")
        | Volver al inicio
