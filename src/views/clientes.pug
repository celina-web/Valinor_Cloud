extends layout

block contenido
  h2 Clientes
  table
    thead
      tr
        th ID
        th Nombre
        th Apellido
        th DNI
        th Teléfono
        th Email
        th Dirección
    tbody
      each cliente in clientes
        tr
          td= cliente.id
          td= cliente.nombre
          td= cliente.apellido
          td= cliente.dni
          td= cliente.telefono || '-'
          td= cliente.email || '-'
          td= cliente.direccion || '-'
      if !clientes.length
        tr
          td(colspan='7') No hay clientes cargados.
