extends ../layout

block content
  +encabezado("Auditoría", "Últimos 100 eventos registrados, del más reciente al más antiguo.")

  +seccion()
    form#formFiltros(class="mb-4 grid grid-cols-1 gap-3 sm:flex sm:flex-wrap sm:items-end")
      +campoSelect("filtroAccion", "Acción", { contenedor: "sm:w-56" })(name="accion")
        option(value="") Todas
        each accion in acciones
          option(value=accion)= accion
      +campo("filtroUsuario", "Usuario", { contenedor: "sm:w-56" })(type="text" name="usuario" placeholder="ej: admin")
      button.btn.btn-primario(type="submit")
        +icono("filtro")(class="size-4")
        | Filtrar

    +alerta("errorAuditoria")
    +tabla(["Fecha", "Usuario", "Acción", "Entidad", "Detalle", "IP"], "tablaAuditoria")
    +vacio("sinRegistros", "No hay eventos que coincidan.")

block scripts
  script(src="/js/auditoria.js")
