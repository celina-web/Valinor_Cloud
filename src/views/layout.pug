//- Shell de la aplicación para usuarios logueados: navbar + sidebar + contenido.
//- Login y error extienden directamente layouts/base (sin shell).
extends layouts/base

block cuerpo
  include includes/navbar
  div(class="flex flex-1")
    include includes/sidebar
    main(class="min-w-0 flex-1 p-4 md:p-6 xl:p-8")
      div(class="mx-auto flex max-w-[1440px] flex-col gap-6")
        block content
  script(src="/js/layout.js")
