extends ../layout

block content
  +encabezado("Gestión de Profesionales", "Alta, edición y baja de los profesionales que atienden los turnos.")

  if puede("profesionales:create")
    +seccion("Registrar nuevo profesional")
      +alerta("errorAlta")
      form#formAlta(class="grid grid-cols-1 gap-x-6 gap-y-4 lg:grid-cols-2")
        +campo("nombre", "Nombre")(type="text" name="nombre" required)
        +campo("apellido", "Apellido")(type="text" name="apellido" required)
        +campo("especialidad", "Especialidad")(type="text" name="especialidad" required)
        +campo("matricula", "Matrícula")(type="text" name="matricula" required)
        +botonera
          button.btn.btn-primario(type="submit")
            +icono("mas")(class="size-4")
            | Guardar Profesional

  +seccion("Listado de profesionales")
    +alerta("errorListado")
    +tabla(["Nombre", "Apellido", "Especialidad", "Matrícula", "Acciones"], "tablaProfesionales")
    +vacio("sinRegistros", "No hay profesionales registrados actualmente.")

  +modal("modalEditar", "Editar Profesional")
    +alerta("errorEdicion")
    form#formEditar(class="grid grid-cols-1 gap-x-6 gap-y-4 md:grid-cols-2")
      input(type="hidden" name="_id")
      +campo("edit_nombre", "Nombre")(type="text" name="nombre" required)
      +campo("edit_apellido", "Apellido")(type="text" name="apellido" required)
      +campo("edit_especialidad", "Especialidad")(type="text" name="especialidad" required)
      +campo("edit_matricula", "Matrícula")(type="text" name="matricula" required)
      +botonera
        button.btn.btn-secundario.btn-cerrar-modal(type="button") Cancelar
        button.btn.btn-primario(type="submit")
          +icono("guardar")(class="size-4")
          | Guardar Cambios

block scripts
  script(src="/js/profesionales.js")
