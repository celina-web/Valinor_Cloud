extends ../layout

block content
  h1 Gestión de Profesionales

  if puede("profesionales:create")
    h2 Registrar Nuevo Profesional
    .error#errorAlta(hidden)
    form#formAlta
      .form-group
        label(for="nombre") Nombre *
        input#nombre(type="text" name="nombre" required)
      .form-group
        label(for="apellido") Apellido *
        input#apellido(type="text" name="apellido" required)
      .form-group
        label(for="especialidad") Especialidad *
        input#especialidad(type="text" name="especialidad" required)
      .form-group
        label(for="matricula") Matrícula *
        input#matricula(type="text" name="matricula" required)
      button(type="submit") Guardar Profesional
    hr

  h2 Listado de Profesionales
  .error#errorListado(hidden)
  table
    thead
      tr
        th Nombre
        th Apellido
        th Especialidad
        th Matrícula
        th Acciones
    tbody#tablaProfesionales
  p#sinRegistros(hidden) No hay profesionales registrados actualmente.

  .modal#modalEditar(hidden)
    .modal-contenido
      h3 Editar Profesional
      .error#errorEdicion(hidden)
      form#formEditar
        input(type="hidden" name="_id")
        .form-group
          label(for="edit_nombre") Nombre *
          input#edit_nombre(type="text" name="nombre" required)
        .form-group
          label(for="edit_apellido") Apellido *
          input#edit_apellido(type="text" name="apellido" required)
        .form-group
          label(for="edit_especialidad") Especialidad *
          input#edit_especialidad(type="text" name="especialidad" required)
        .form-group
          label(for="edit_matricula") Matrícula *
          input#edit_matricula(type="text" name="matricula" required)
        .modal-botones
          button(type="submit") Guardar Cambios
          button.btn-secundario.btn-cerrar-modal(type="button") Cancelar

block scripts
  script(src="/js/profesionales.js")
