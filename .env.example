PORT=3000
# Con Docker Compose este valor se sobrescribe (host "mongo"); aplica al correr sin Docker
MONGO_URI=mongodb://127.0.0.1:27017/turnoflex
# Clave para firmar los JWT (HS256). Usá un texto largo y aleatorio.
JWT_SECRET=cambiar-por-un-texto-largo
# Minutos de vida del token (se renueva solo mientras el usuario usa la app)
JWT_MINUTOS=30
# Chat de consultas: máximo de chats abiertos (pendientes + activos) por admin
CHAT_MAX_POR_ADMIN=3
# Minutos que espera una consulta a ser aceptada antes de expirar (acepta decimales para probar)
CHAT_TIMEOUT_MINUTOS=5
